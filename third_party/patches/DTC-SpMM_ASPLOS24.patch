+}
+
+static int dtc_hardware_max_dynamic_shared_mem_bytes() {
+  int device = 0;
+  cudaGetDevice(&device);
+  int limit = 0;
+  cudaDeviceGetAttribute(&limit, cudaDevAttrMaxSharedMemoryPerBlockOptin,
+                         device);
+  if (limit <= 0) {
+    cudaDeviceGetAttribute(&limit, cudaDevAttrMaxSharedMemoryPerBlock, device);
+  }
+  return limit;
+}
+
+static constexpr int DTC_SHARED_MEM_SAFETY_MARGIN = 8192; // 8 KiB headroom
+
+static int dtc_usable_dynamic_shared_mem_bytes() {
+  const int hardware_max = dtc_hardware_max_dynamic_shared_mem_bytes();
+  return hardware_max > DTC_SHARED_MEM_SAFETY_MARGIN
+             ? hardware_max - DTC_SHARED_MEM_SAFETY_MARGIN
+             : 0;
+}
